          "name": {
            "text": "system_setup_menu Export"
          },
          "specification": {
            "text": "@EventDriven\n@SuperSteps(no)\n\ninterface:\n    in event Enter\n    in event Next\n    in event Escape\n    in event Motor1\n    in event Motor2\n    in event Power\n    in event Spin\n    in event Speed\n    in event StatePower\n    in event StateSpeed\n    in event StateSpin\n    \n    \n    var m_power : boolean// 1 = ON,  = OFF\n    var m_speed : integer \n    var m_spin : boolean // 1 = R, 0 = L\n\n    var motor : integer"
          }
        },
        "z": 1
      },
